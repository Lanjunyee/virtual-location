<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true" android:background="@color/ui_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:focusableInTouchMode="true">
    <LinearLayout style="@style/UiCard">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_refresh" style="@style/UiTitle" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/PreferencesActivity_field_1" style="@style/UiLabel" android:labelFor="@id/input_time_interval" />
      <EditText android:id="@+id/input_time_interval" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/UiInput" android:inputType="number" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/PreferencesActivity_field_2" style="@style/UiLabel" android:labelFor="@id/input_fixed_count" />
      <EditText android:id="@+id/input_fixed_count" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/UiInput" android:inputType="numberSigned" />
    </LinearLayout>
    <LinearLayout style="@style/UiCard">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_joystick" style="@style/UiTitle" />
      <CheckBox android:id="@+id/input_fixed_joystick_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/PreferencesActivity_field_3" android:textSize="16sp" android:textColor="@color/ui_text" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/PreferencesActivity_field_4" style="@style/UiLabel" android:labelFor="@id/input_fixed_joystick_increment" />
      <EditText android:id="@+id/input_fixed_joystick_increment" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/UiInput" android:inputType="numberDecimal" />
    </LinearLayout>
    <LinearLayout style="@style/UiCard">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/PreferencesActivity_heading_3" style="@style/UiTitle" />
      <CheckBox android:id="@+id/input_trip_hold_destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/PreferencesActivity_field_5" android:textSize="16sp" android:textColor="@color/ui_text" />
    </LinearLayout>
    <Button android:id="@+id/button_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_button_save" style="@style/UiPrimary" />
    <Button android:id="@+id/button_cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_button_cancel" style="@style/UiButton" />
  </LinearLayout>
</ScrollView>