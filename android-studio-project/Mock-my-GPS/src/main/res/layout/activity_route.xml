<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true" android:background="@color/ui_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:focusableInTouchMode="true">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_route_help" style="@style/UiHelp" />
    <LinearLayout style="@style/UiCard">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_points" style="@style/UiLabel" android:labelFor="@id/route_points" />
      <EditText android:id="@+id/route_points" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/UiInput" android:inputType="textNoSuggestions|textMultiLine" android:minLines="4" android:maxLines="8" android:gravity="top" android:maxLength="2097152" android:hint="@string/ui_points_hint" />
      <Button android:id="@+id/route_map" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_plan_route" style="@style/UiButton" />
      <Button android:id="@+id/route_import" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_import" style="@style/UiButton" />
    </LinearLayout>
    <LinearLayout style="@style/UiCard">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_speed" style="@style/UiLabel" android:labelFor="@id/route_speed" />
      <EditText android:id="@+id/route_speed" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/UiInput" android:inputType="numberDecimal" />
    </LinearLayout>
    <LinearLayout style="@style/UiCard">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_playback" style="@style/UiTitle" />
      <TextView android:id="@+id/route_status" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/UiHelp" android:accessibilityLiveRegion="polite" />
      <Button android:id="@+id/route_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_start_route" style="@style/UiPrimary" />
      <Button android:id="@+id/route_pause" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_pause" style="@style/UiButton" />
      <Button android:id="@+id/route_resume" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_resume" style="@style/UiButton" />
      <Button android:id="@+id/route_stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_stop" style="@style/UiDanger" />
    </LinearLayout>
    <Button android:id="@+id/route_developer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_developer" style="@style/UiButton" />
  </LinearLayout>
</ScrollView>